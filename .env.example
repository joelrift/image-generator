# Copy to .env.local and fill in when you are ready to go live.
# With no keys set the app runs in Mock mode: the whole UI is clickable and
# returns generated placeholder images. Nothing here is exposed to the browser —
# none of these are NEXT_PUBLIC_*, so they stay server-side.

# fal | bfl | replicate | comfyui
# Leave unset to auto-select: bfl if BFL_API_KEY is present, else fal if FAL_KEY
# is present, otherwise Mock.
RENDER_PROVIDER=

FAL_KEY=
REPLICATE_API_TOKEN=

# Black Forest Labs (first-party FLUX).
# Endpoints confirmed live against a real account (Aug 2026): flux-kontext-pro
# and flux-pro-1.0-fill. The standalone depth/canny ControlNet endpoints have
# been retired (404), so generate() uses Kontext by default.
BFL_API_KEY=
# BFL_BASE_URL=https://api.bfl.ai        # or a regional host (api.us1.bfl.ai)
# BFL_GENERATE_MODE=kontext              # kontext (default) | control
# BFL_ENDPOINT_KONTEXT=v1/flux-kontext-pro
# BFL_ENDPOINT_FILL=v1/flux-pro-1.0-fill
# BFL_OUTPUT_FORMAT=png
# BFL_POLL_INTERVAL_MS=1200
# BFL_POLL_TIMEOUT_MS=180000
#
# Only used if BFL_GENERATE_MODE=control (not reachable on the current API):
# BFL_ENDPOINT_DEPTH=v1/flux-pro-1.0-depth
# BFL_ENDPOINT_CANNY=v1/flux-pro-1.0-canny
# BFL_GUIDANCE_MIN=2.5
# BFL_GUIDANCE_MAX=30
# BFL_SEND_DIMENSIONS=0

# Nano Banana Pro / Gemini image — used by the "add something" region edit
GEMINI_API_KEY=

# Prompt enrichment (Phase 4). Either works; Anthropic wins if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Self-hosted ComfyUI, e.g. a RunPod endpoint
COMFYUI_URL=
