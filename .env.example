# Copy to .env.local and fill in when you are ready to go live.
# With no keys set the app runs in Mock mode: the whole UI is clickable and
# returns generated placeholder images. Nothing here is exposed to the browser —
# none of these are NEXT_PUBLIC_*, so they stay server-side.

# Provider selection. fal | bfl | gemini | replicate | comfyui
#
# RENDER_PROVIDER sets one backend for everything. To split the pipeline by stage
# — geometry-locked base, precise masked edits, then a photoreal finishing pass —
# set the per-op overrides, which take precedence:
#   RENDER_PROVIDER_GENERATE   base render        (generate)
#   RENDER_PROVIDER_EDIT       masked edits       (Change this / Add something)
#   RENDER_PROVIDER_FINALIZE   finishing pass     (Finalize)
#
# Recommended pipeline — BFL renders and edits (Fill honours the mask), Gemini
# finishes. Leaving EDIT unset keeps edits on the shared RENDER_PROVIDER (bfl):
#   RENDER_PROVIDER=bfl
#   RENDER_PROVIDER_FINALIZE=gemini
#
# (finalize also defaults to Gemini on its own when GEMINI_API_KEY is present.)
# Leave all unset to auto-select from whichever key is present, else Mock.
RENDER_PROVIDER=
# RENDER_PROVIDER_GENERATE=
# RENDER_PROVIDER_EDIT=
# RENDER_PROVIDER_FINALIZE=

FAL_KEY=
REPLICATE_API_TOKEN=

# Black Forest Labs (first-party FLUX).
# Endpoints confirmed live against a real account (Aug 2026): flux-kontext-pro
# and flux-pro-1.0-fill. The standalone depth/canny ControlNet endpoints have
# been retired (404), so generate() uses Kontext by default.
BFL_API_KEY=
# BFL_BASE_URL=https://api.bfl.ai        # or a regional host (api.us1.bfl.ai)
# BFL_GENERATE_MODE=kontext              # kontext (default) | control
# BFL_ENDPOINT_KONTEXT=v1/flux-kontext-pro
# BFL_ENDPOINT_FILL=v1/flux-pro-1.0-fill
# BFL_OUTPUT_FORMAT=png
# BFL_POLL_INTERVAL_MS=1200
# BFL_POLL_TIMEOUT_MS=180000
#
# Only used if BFL_GENERATE_MODE=control (not reachable on the current API):
# BFL_ENDPOINT_DEPTH=v1/flux-pro-1.0-depth
# BFL_ENDPOINT_CANNY=v1/flux-pro-1.0-canny
# BFL_GUIDANCE_MIN=2.5
# BFL_GUIDANCE_MAX=30
# BFL_SEND_DIMENSIONS=0

# Google Gemini image ("Nano Banana") — an instruction editor, good as the edit
# stage behind a geometry-locked base (set RENDER_PROVIDER_EDIT=gemini).
# NOTE: lib/providers/gemini.ts was written without access to the live API; a
# first-run 400 means a field/model id needs checking against ai.google.dev.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # or a Nano Banana Pro / 3-pro image id
# GEMINI_RESPONSE_MODALITIES=TEXT,IMAGE       # try IMAGE if modalities are rejected
# GEMINI_API_VERSION=v1beta

# Prompt enrichment (Phase 4). Either works; Anthropic wins if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Self-hosted ComfyUI, e.g. a RunPod endpoint
COMFYUI_URL=
